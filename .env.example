# Core app
NEXT_PUBLIC_APP_URL=http://localhost:43123
ADMIN_PASSWORD=echale-demo-admin
ADMIN_SESSION_SALT=echale-hackathon

# Storage
# For production on Vercel, use a managed Postgres URL (Neon recommended).
# If empty, the app uses local mock JSON storage in /data/mock-db.json (demo mode).
DATABASE_URL=
# Optional explicit path for mock JSON store (Vercel defaults to /tmp/echale-mock-db.json)
MOCK_DATA_PATH=

# Pey / CoDi
# Set PEY_MODE=live in production demo with real money.
# Keep PEY_MODE=mock for offline/demo UX without real charges.
PEY_MODE=mock

# Global fallback key (used if a story-specific key env is missing)
PEY_API_KEY=

# Platform key used for self-serve "/crear" bank account onboarding and
# bankAccountId-based QR creation.
PEY_PLATFORM_API_KEY=

# Per-story keys (story.peyKeyEnv points to one of these env names)
PEY_API_KEY_SANTIAGO=
PEY_API_KEY_ADRIAN=
PEY_API_KEY_MIRIAM=

# Webhook secrets: one global fallback + optional per-key secrets
PEY_WEBHOOK_SECRET=
PEY_WEBHOOK_SECRET_SANTIAGO=
PEY_WEBHOOK_SECRET_ADRIAN=
PEY_WEBHOOK_SECRET_MIRIAM=
PEY_WEBHOOK_SECRET_PLATFORM=

# Optional override for local testing of /bank-account APIs:
# - "mock" (default when PEY_MODE=mock)
# - "live" (forces real calls)
PEY_BANK_ACCOUNT_MODE=mock

PEY_BASE_URL=https://api.pey.mx
PEY_QR_EXPIRATION_SECONDS=600
PEY_PUSH_ENDPOINT=/codi/push
PEY_TRANSACTION_LOOKUP_PATH=/transactions/{transactionId}

# Handout CLABE (configurable, currently not required by POST /codi/qr)
PEY_CLABE=000000000000000001
